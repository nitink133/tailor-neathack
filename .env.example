# Copy to .env.local (gitignored) or export in your shell. Never commit real values.

# Neatlogs project key. Only needed for `neatlogs doctor --probe` and real traces.
NEATLOGS_API_KEY=

# Neatlogs ingest base URL. Default is US; EU projects use https://eu.ingest.neatlogs.com
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
