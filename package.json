{
  "name": "tailor-neathack",
  "version": "0.0.0",
  "private": true,
  "description": "Tailor \u2014 neatHack (October 2026) candidate project",
  "type": "module",
  "engines": {
    "node": ">=26.7.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "doctor:local": "npm exec --offline --no -- neatlogs doctor --local --json",
    "doctor:probe": "node --env-file-if-exists=.env.local node_modules/neatlogs/dist/cli.mjs doctor --probe --json",
    "smoke:trace": "node --env-file-if-exists=.env.local scripts/smoke-trace.ts",
    "env:check": "node --env-file-if-exists=.env.local -e \"const v=process.env.NEATLOGS_API_KEY;console.log('NEATLOGS_API_KEY:',typeof v,v?'set':'empty-or-missing')\"",
    "build": "tsc -p tsconfig.browser.json",
    "dev": "npm run build && node src/server.ts",
    "test:ui": "playwright test",
    "fixture": "node scripts/fixture.ts"
  },
  "dependencies": {
    "neatlogs": "1.1.28"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
